void main()
{
    ReadVSPFile( "full_v2.vsp3" );
    array<string>@ geoms = FindGeoms();
    for ( int g = 0; g < int(geoms.size()); g++ )
    {
        if ( GetGeomName( geoms[g] ) != "Fuselage" ) { continue; }
        string fid = geoms[g];
        int n = GetNumXSec( GetXSecSurf( fid, 0 ) );
        Print( "Fuselage sections: " + n );
        for ( int i = 0; i < n; i++ )
        {
            Print( "XSec_" + i
                 + "  xpct=" + GetParmVal( fid, "XLocPercent", "XSec_" + i )
                 + "  zpct=" + GetParmVal( fid, "ZLocPercent", "XSec_" + i )
                 + "  W=" + GetParmVal( fid, "Ellipse_Width", "XSecCurve_" + i )
                 + "  H=" + GetParmVal( fid, "Ellipse_Height", "XSecCurve_" + i ) );
        }
    }
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( err.GetErrorString() );
    }
}
