    SetParmVal( wid, "Sweep", "XSec_1", 13.8 );
    SetParmVal( wid, "Sweep_Location", "XSec_1", 0.25 );
    SetParmVal( wid, "Dihedral", "XSec_1", 3.0 );
    SetParmVal( wid, "Twist", "XSec_1", -3.0 );
    SetParmVal( wid, "Twist_Location", "XSec_1", 0.25 );
    SetParmVal( wid, "SectTess_U", "XSec_1", 30 );
    SetParmVal( wid, "Tess_W", "Shape", 41 );
    Update();
    InsertXSec( wid, 1, XS_FILE_AIRFOIL );
    SetDriverGroup( wid, 2, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    SetParmVal( wid, "Span", "XSec_2", 2.40 );
    SetParmVal( wid, "Sweep", "XSec_2", 31.0 );
    SetParmVal( wid, "Sweep_Location", "XSec_2", 0.25 );
    SetParmVal( wid, "Dihedral", "XSec_2", 70.0 );
    SetParmVal( wid, "Twist", "XSec_2", -5.0 );
    SetParmVal( wid, "Twist_Location", "XSec_2", 0.25 );
    SetParmVal( wid, "SectTess_U", "XSec_2", 14 );
    Update();
    SetParmVal( wid, "Tip_Chord", "XSec_1", 2.4180 );
    Update();
    SetParmVal( wid, "Tip_Chord", "XSec_2", 0.95 );
    Update();
    string af_file = "../../../../airfoils/dat_clean/sc20412_selig.dat";
    string wsurf = GetXSecSurf( wid, 0 );
    for ( int i = 0; i <= 2; i++ )
    {
        ChangeXSecShape( wsurf, i, XS_FILE_AIRFOIL );
        ReadFileAirfoil( GetXSec( wsurf, i ), af_file );
    }
    Update();

    //========================= Nacelles (unchanged) ==========================//
    string nid = AddGeom( "FUSELAGE", "" );
    SetGeomName( nid, "Nacelle" );
    SetParmVal( nid, "Length", "Design", 7.5 );
    SetParmVal( nid, "X_Rel_Location", "XForm", 25.1 + wing_dx );
    SetParmVal( nid, "Y_Rel_Location", "XForm", 6.9 );
    SetParmVal( nid, "Z_Rel_Location", "XForm", 1.0 );
    SetParmVal( nid, "Sym_Planar_Flag", "Sym", SYM_XZ );
    Update();
    string nsurf = GetXSecSurf( nid, 0 );
    for ( int i = 1; i <= 3; i++ ) { ChangeXSecShape( nsurf, i, XS_ELLIPSE ); }
    Update();
    array<double> nx = { 0.0, 0.7, 2.8, 5.6, 7.5 };
    array<double> nd = { 0.0, 2.1, 2.9, 2.6, 0.0 };
    for ( int pass = 0; pass < 4; pass++ )
    {
        for ( int k = 0; k <= 4; k++ )
        {
            int i = k;
            if ( pass % 2 == 0 ) { i = 4 - k; }
            SetParmVal( nid, "XLocPercent", "XSec_" + i, nx[i] / 7.5 );
            Update();
        }
    }
    for ( int i = 1; i <= 3; i++ )
    {
        SetParmVal( nid, "Ellipse_Width",  "XSecCurve_" + i, nd[i] );
        SetParmVal( nid, "Ellipse_Height", "XSecCurve_" + i, nd[i] );
    }
    SetParmVal( nid, "Tess_U", "Shape", 17 );
    SetParmVal( nid, "Tess_W", "Shape", 21 );
    Update();

    //========================== Pylons (unchanged) ===========================//
    string pid = AddGeom( "WING", "" );
    SetGeomName( pid, "Pylon" );
    SetParmVal( pid, "X_Rel_Location", "XForm", 24.0 + wing_dx );
    SetParmVal( pid, "Y_Rel_Location", "XForm", 6.9 );
    SetParmVal( pid, "Z_Rel_Location", "XForm", -2.0 );
    SetParmVal( pid, "X_Rel_Rotation", "XForm", 90.0 );
    SetParmVal( pid, "Sym_Planar_Flag", "Sym", SYM_XZ );
    SetDriverGroup( pid, 1, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    SetParmVal( pid, "Span", "XSec_1", 3.2 );
    SetParmVal( pid, "Root_Chord", "XSec_1", 3.6 );
    SetParmVal( pid, "Tip_Chord", "XSec_1", 2.4 );
