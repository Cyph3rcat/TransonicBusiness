    SetParmVal( pid, "Twist", "XSec_1", 0.0 );
    SetParmVal( pid, "SectTess_U", "XSec_1", 8 );
    Update();
    SetParmVal( pid, "ThickChord", "XSecCurve_0", 0.09 );
    SetParmVal( pid, "ThickChord", "XSecCurve_1", 0.09 );
    Update();

    //=================== Vertical tail (RESIZED, parametric) =================//
    string vid = AddGeom( "WING", "" );
    SetGeomName( vid, "VertTail" );
    SetParmVal( vid, "X_Rel_Location", "XForm", 31.6000 );
    SetParmVal( vid, "Z_Rel_Location", "XForm", 2.0 );
    SetParmVal( vid, "X_Rel_Rotation", "XForm", 90.0 );
    SetParmVal( vid, "Sym_Planar_Flag", "Sym", 0 );
    SetDriverGroup( vid, 1, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    SetParmVal( vid, "Span", "XSec_1", 7.3730 );
    SetParmVal( vid, "Root_Chord", "XSec_1", 8.6184 );
    SetParmVal( vid, "Tip_Chord", "XSec_1", 5.2159 );
    SetParmVal( vid, "Sweep", "XSec_1", 35.0 );
    SetParmVal( vid, "Sweep_Location", "XSec_1", 0.25 );
    SetParmVal( vid, "Dihedral", "XSec_1", 0.0 );
    SetParmVal( vid, "Twist", "XSec_1", 0.0 );
    SetParmVal( vid, "SectTess_U", "XSec_1", 12 );
    Update();

    //======================== Dorsal fin (unchanged) =========================//
    string did = AddGeom( "WING", "" );
    SetGeomName( did, "DorsalFin" );
    SetParmVal( did, "X_Rel_Location", "XForm", 26.5 );
    SetParmVal( did, "Z_Rel_Location", "XForm", 2.60 );
    SetParmVal( did, "X_Rel_Rotation", "XForm", 90.0 );
