// AUTO-GENERATED by gen_v6.py -- variant vt51.0_beta
// S_HT = 51.6800 ft^2, S_VT = 51.0000 ft^2, wing root LE = 15.9000 ft
void main()
{
    double wing_dx = -3.1000;

    //================= Fuselage (user's v5 reloft, tail closed) ==============//
    string fid = AddGeom( "FUSELAGE", "" );
    SetGeomName( fid, "Fuselage" );
    SetParmVal( fid, "Length", "Design", 42.2 );
    Update();
    string fsurf = GetXSecSurf( fid, 0 );
    // 7 sections: the sparse-loft convention (config.md D.5d) -- one XSec per
    // curvature event, spline fairs between. Section 0 is a blunt radome ellipse
    // closed by a round cap, not a point.
    while ( GetNumXSec( fsurf ) > 7 ) { CutXSec( fid, 1 ); }
    while ( GetNumXSec( fsurf ) < 7 ) { InsertXSec( fid, 1, XS_ELLIPSE ); }
    Update();
    for ( int i = 0; i < 7; i++ ) { ChangeXSecShape( fsurf, i, XS_ELLIPSE ); }
    Update();

    array<double> fx = { 0.00000, 5.73700, 10.85200, 17.00000, 23.40000, 30.50000, 42.20000 };
    array<double> fz = { -1.92850, -1.11490, 0.00000, 0.00000, 0.00000, 0.47690, 1.79560 };
    array<double> fh = { 1.18617, 3.70512, 6.04571, 6.10000, 6.10000, 4.69600, 0.60000 };
    array<double> fw = { 1.15014, 4.88275, 5.70454, 6.10000, 6.10000, 4.69600, 0.60000 };
    array<double> fta = { 28.42105, 28.42105, -4.73684, 0.00000, 0.00000, 0.00000, 2.36842 };
    array<double> fba = { 30.78947, 0.00000, -4.73684, 0.00000, 0.00000, 0.00000, -11.84211 };
    array<double> fsa = { 56.84211, 7.10526, 4.73684, 0.00000, 0.00000, 0.00000, -45.00000 };
    array<double> fst = { 0.75000, 1.00000, 1.00000, 1.00000, 1.00000, 1.00000, 0.75000 };

    // XLocPercent is limit-clamped against neighbours, so a single assignment
    // pass silently loses stations -- alternate the direction until converged
    // (README gotcha 3).
    for ( int pass = 0; pass < 4; pass++ )
    {
        for ( int k = 0; k < 7; k++ )
        {
            int i = k;
            if ( pass % 2 == 0 ) { i = 7 - 1 - k; }
            SetParmVal( fid, "XLocPercent", "XSec_" + i, fx[i] / 42.2 );
            SetParmVal( fid, "ZLocPercent", "XSec_" + i, fz[i] / 42.2 );
            Update();
        }
    }
    for ( int i = 0; i < 7; i++ )
    {
        SetParmVal( fid, "Ellipse_Height", "XSecCurve_" + i, fh[i] );
        SetParmVal( fid, "Ellipse_Width",  "XSecCurve_" + i, fw[i] );
        SetParmVal( fid, "TopLAngleSet",     "XSec_" + i, 1 );
        SetParmVal( fid, "TopLStrengthSet",  "XSec_" + i, 1 );
        SetParmVal( fid, "BottomLAngleSet",  "XSec_" + i, 1 );
        SetParmVal( fid, "BottomLStrengthSet", "XSec_" + i, 1 );
        SetParmVal( fid, "TopLAngle",      "XSec_" + i, fta[i] );
        SetParmVal( fid, "BottomLAngle",   "XSec_" + i, fba[i] );
        SetParmVal( fid, "LeftLAngle",     "XSec_" + i, fsa[i] );
        SetParmVal( fid, "RightLAngle",    "XSec_" + i, fsa[i] );
        SetParmVal( fid, "TopLStrength",    "XSec_" + i, fst[i] );
        SetParmVal( fid, "BottomLStrength", "XSec_" + i, fst[i] );
        SetParmVal( fid, "LeftLStrength",   "XSec_" + i, fst[i] );
        SetParmVal( fid, "RightLStrength",  "XSec_" + i, fst[i] );
        Update();
    }
    // Nose: round cap (radome). Tail: round cap -- v5 left CapUMaxOption = 0,
    // i.e. an OPEN body with a 2.18 ft^2 hole at the tail. This is the fix.
    SetParmVal( fid, "CapUMinOption", "EndCap", 2 );
    SetParmVal( fid, "CapUMinLength", "EndCap", 1.0 );
    SetParmVal( fid, "CapUMinStrength", "EndCap", 1.0 );
    SetParmVal( fid, "CapUMaxOption", "EndCap", 2 );
    SetParmVal( fid, "CapUMaxLength", "EndCap", 0.5 );
    SetParmVal( fid, "CapUMaxStrength", "EndCap", 0.5 );
    SetParmVal( fid, "Tess_U", "Shape", 61 );
    SetParmVal( fid, "Tess_W", "Shape", 33 );
    Update();

    //======================= Belly fairing (unchanged) =======================//
    string bid = AddGeom( "FUSELAGE", "" );
    SetGeomName( bid, "BellyFairing" );
    SetParmVal( bid, "Length", "Design", 14.5 );
    SetParmVal( bid, "X_Rel_Location", "XForm", 16.0 + wing_dx );
    SetParmVal( bid, "Z_Rel_Location", "XForm", -2.20 );
    Update();
    string bsurf = GetXSecSurf( bid, 0 );
    for ( int i = 1; i <= 3; i++ ) { ChangeXSecShape( bsurf, i, XS_ROUNDED_RECTANGLE ); }
    Update();
    array<double> bx = { 0.0,  3.0,  7.25, 11.5, 14.5 };
    array<double> bw = { 0.00, 5.20, 7.00, 5.80, 0.00 };
