    SetParmVal( hid, "Twist", "XSec_1", 0.0 );
    SetParmVal( hid, "SectTess_U", "XSec_1", 16 );
    Update();

    //================================= Sets ==================================//
    SetSetName( 3, "ThickBodies" );
    SetSetName( 4, "ThinLifting" );
    SetSetFlag( fid, 3, true );
    SetSetFlag( bid, 3, true );
    SetSetFlag( nid, 3, true );
    SetSetFlag( wid, 4, true );
    SetSetFlag( pid, 4, true );
    SetSetFlag( vid, 4, true );
    SetSetFlag( did, 4, true );
    SetSetFlag( hid, 4, true );
    Update();

    Print( "VT area (expect 51.00): " + GetParmVal( vid, "TotalArea", "WingGeom" ) );
    Print( "HT area (expect 51.68): " + GetParmVal( hid, "TotalArea", "WingGeom" ) );
    Print( "Wing area (expect 201.76 incl winglet): " + GetParmVal( wid, "TotalArea", "WingGeom" ) );
