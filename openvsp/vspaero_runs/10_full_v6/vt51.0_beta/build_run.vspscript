    SetParmVal( did, "SectTess_U", "XSec_1", 6 );
    Update();
    SetParmVal( did, "ThickChord", "XSecCurve_0", 0.05 );
    SetParmVal( did, "ThickChord", "XSecCurve_1", 0.05 );
    Update();

    //================= Horizontal tail (RESIZED, on the fin tip) =============//
    string hid = AddGeom( "WING", "" );
    SetGeomName( hid, "HorizTail" );
    SetParmVal( hid, "X_Rel_Location", "XForm", 37.6133 );
    SetParmVal( hid, "Z_Rel_Location", "XForm", 9.3730 );
    SetDriverGroup( hid, 1, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
